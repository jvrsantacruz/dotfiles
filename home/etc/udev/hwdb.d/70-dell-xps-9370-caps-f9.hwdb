# Caps Lock emits F9 on this Dell XPS 13 9370 (dlap), used as the tmux prefix.
# Remapped in the kernel input layer so it holds under Wayland, Xorg and the TTY.
#
# Install:
#   sudo install -m644 work/etc/udev/hwdb.d/70-dell-xps-9370-caps-f9.hwdb /etc/udev/hwdb.d/
#   sudo systemd-hwdb update
#   sudo udevadm trigger --subsystem-match=input --action=change

evdev:atkbd:dmi:bvn*:bvr*:bd*:svnDellInc.:pnXPS139370:*
 KEYBOARD_KEY_3a=f9
