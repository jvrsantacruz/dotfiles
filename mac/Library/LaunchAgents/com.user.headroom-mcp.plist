<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
	<key>KeepAlive</key>
	<true/>
	<key>Label</key>
	<string>com.user.headroom-mcp</string>
	<key>LowPriorityIO</key>
	<true/>
	<key>ProcessType</key>
	<string>Background</string>
	<key>ProgramArguments</key>
	<array>
		<string>/bin/zsh</string>
		<string>-lc</string>
		<string>exec memcap 1G taskpolicy -b headroom mcp serve --transport http --host 127.0.0.1 --port 8788 --path /mcp</string>
	</array>
	<key>RunAtLoad</key>
	<true/>
	<key>StandardErrorPath</key>
	<string>/tmp/headroom-mcp.log</string>
	<key>StandardOutPath</key>
	<string>/tmp/headroom-mcp.log</string>
	<key>ThrottleInterval</key>
	<integer>30</integer>
</dict>
</plist>
