# Add ~/.local/bin to PATH
export PATH="$HOME/.local/bin:$PATH"

# Enable vi mode for command line editing
bindkey -v

# Open current command in $EDITOR when pressing 'v' in command mode
autoload -Uz edit-command-line
zle -N edit-command-line
bindkey -M vicmd 'v' edit-command-line

# Optional: Reduce delay when switching modes (ESC key)
export KEYTIMEOUT=1

# Optional: Show vi mode indicator in prompt
# bindkey -M vicmd 'k' history-search-backward
# bindkey -M vicmd 'j' history-search-forward
#
alias ..="cd .."
alias ...="cd ../.."
alias ....="cd ../../.."

function branch {
    git symbolic-ref --short HEAD
}

function pr_url {
    gh pr list --head "$1" --json url -q '.[].url' | head -n 1
}

function pr_open {
    open "$(pr_url $(branch))"
}

function push_force {
    local ref=$(branch)

    if [[ "$ref" == "main" || "$ref" == "master" ]]; then
        echo "push_force: refusing to force-push $ref" >&2
        return 1
    fi

    git fetch origin "$ref" || return 1
    local expected_remote_ref=$(git rev-parse FETCH_HEAD) || return 1
    git push origin "$ref" --force-with-lease="$ref:$expected_remote_ref"
}

DD_USER_PREFIX="jvrsantacruz"

function master_branch {
    if git ls-remote --exit-code --heads origin main >/dev/null 2>&1; then
        echo main
    elif git ls-remote --exit-code --heads origin master >/dev/null 2>&1; then
        echo master
    else
        echo "refresh_branch: could not find origin/main or origin/master" >&2
        return 1
    fi
}

function refresh_branch {
    local ref=$(branch)
    local base_ref=$(master_branch)

    git fetch origin "$base_ref" || return 1
    git rebase "origin/$base_ref" || return 1
    push_force
}

function goto_worker {
    cd ~/dd/dd-source/domains/ci-app/apps/apis/deployment-gates-worker/
}

function goto_orchestrator {
    cd ~/dd/dd-go/ci-app/apps/deployment-gates-orchestrator/
}

# AI API Keys
source ~/.zshrc.env

# Initialize Starship prompt
eval "$(starship init zsh)"

# Workforest - Git worktree manager
export WORKFOREST_REPOS_DIR=~/dd
export WORKFOREST_BASE=~/dd/workforest
source ~/dev/workforest/shell/workforest-functions.zsh

# pi-subagents: isolated worktree base dir (fallback when config unset)
export PI_SUBAGENTS_WORKTREE_DIR="$HOME/.pi/agent/worktrees"

# workon - project navigator
workon() {
  if [[ "$1" == "list" || "$1" == "archive" || "$1" == "-h" || "$1" == "--help" ]]; then
    _workon "$@"
    return
  fi
  local _path exit_code
  _path=$(_workon "$@")
  exit_code=$?
  [[ $exit_code -ne 0 ]] && { echo "$_path" >&2; return $exit_code; }
  [[ -n "$_path" ]] && cd "$_path"
}

_workon_complete() {
  local completions
  completions=($(_workon --complete "${words[2]}"))
  compadd -a completions
}
if (( $+functions[compdef] )); then
  compdef _workon_complete workon
fi

function cheats { glow -p ~/.config/nvim/cheatsheet.md }

# codex via the Datadog AI Gateway (prod). Codex has no apiKeyHelper, so the
# ddtool token must exist before launch; this refreshes it on every invocation.
alias codex='AI_GATEWAY_API_KEY="$(ddtool auth token rapid-ai-platform --datacenter us1.ddbuild.io)" codex -c "model_provider=ai-gateway"'

function awsdd {
    aws-vault exec sso-prod-engineering -- aws $@
}
