function cheats { glow -p ~/.config/nvim/cheatsheet.md }

# codex via the Datadog AI Gateway (prod). Codex has no apiKeyHelper, so the
# ddtool token must exist before launch; this refreshes it on every invocation.
alias codex='AI_GATEWAY_API_KEY="$(ddtool auth token rapid-ai-platform --datacenter us1.ddbuild.io)" codex -c "model_provider=ai-gateway"'

function awsdd {
    aws-vault exec sso-prod-engineering -- aws $@
}

# Ensure the headroom compression proxy listens on $1, starting it on demand.
# First bind is slow (loads code-aware model); give it up to 60s.
function _headroom-ensure-proxy {
    local port=$1
    nc -z 127.0.0.1 $port 2>/dev/null && return 0
    headroom proxy --port $port &>/tmp/headroom-proxy.log &
    disown
    for i in {1..120}; do nc -z 127.0.0.1 $port 2>/dev/null && break; sleep 0.5; done
    nc -z 127.0.0.1 $port 2>/dev/null || { echo "headroom proxy failed to start, see /tmp/headroom-proxy.log"; return 1 }
}

# claude through the headroom compression proxy. Routes only this invocation
# via env var, leaves no claude config behind.
function hclaude {
    local port=${HEADROOM_PORT:-8787}
    _headroom-ensure-proxy $port || return 1
    sleep 1
    ANTHROPIC_BASE_URL=http://127.0.0.1:$port claude "$@"
}

# pi through the headroom proxy. The headroom pi extension picks up
# HEADROOM_URL and repoints anthropic/openai providers for this invocation.
function hpi {
    local port=${HEADROOM_PORT:-8787}
    _headroom-ensure-proxy $port || return 1
    HEADROOM_URL=http://127.0.0.1:$port pi "$@"
}
