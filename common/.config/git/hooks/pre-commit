#!/bin/sh
# Refuse to commit staged secrets, and words that name my work.
#
# Lives in jvrsantacruz/dotfiles and is stowed to ~/.config/git/hooks/pre-commit.
# Repos opt in by symlinking .git/hooks/pre-commit at it; infra/home/local.yml
# does that for the repos that hold my own configuration and notes.
#
# Deliberate bypass: git commit --no-verify

if ! command -v gitleaks >/dev/null 2>&1; then
    echo "pre-commit: gitleaks is not installed, refusing to commit unchecked." >&2
    echo "            sudo apt install gitleaks" >&2
    echo "            or bypass with: git commit --no-verify" >&2
    exit 1
fi

# --redact keeps the secret out of the terminal and the shell scrollback, so a
# blocked commit does not leak what it was trying to commit.
if ! gitleaks protect --staged --redact --no-banner; then
    echo >&2
    echo "pre-commit: staged changes look like they contain a secret." >&2
    echo "            Take it out of the commit, or bypass with:" >&2
    echo "            git commit --no-verify" >&2
    exit 1
fi

# The words name what a repository of mine must not, so the list lives outside
# every repository. Without the list the check passes. A repository about work
# turns it off:  git config hooks.privateWords false
words="$HOME/.config/git/private-words"
[ "$(git config --bool hooks.privateWords)" = false ] && exit 0
[ -s "$words" ] || exit 0

hits=$(git diff --cached -U0 --no-color | grep '^+' | grep -v '^+++' | grep -i -E -c -f "$words")
if [ "$hits" -gt 0 ]; then
    echo "pre-commit: $hits staged lines hold a private word. This repository must not." >&2
    echo "            Find them: git diff --cached | grep -inEf $words" >&2
    echo "            Move them to an untracked file, or bypass with: git commit --no-verify" >&2
    exit 1
fi
