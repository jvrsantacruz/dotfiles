# Caps Lock emits F9, used as the tmux prefix (see .tmux.conf).
#
# The remap happens in the kernel input layer, so it applies before the
# compositor and needs no session hook: it works under Wayland, Xorg and on
# the bare TTY alike. This replaced ~/.Xmodmap, which GNOME reset on Xorg and
# ignores entirely on Wayland.
#
# 3a is the Caps Lock scan code; key identifiers are KEY_* from the kernel
# input header, lowercased with the key_ prefix dropped.
#
# NOT stowed -- see .stow-local-ignore. Install with:
#   sudo install -m644 etc/udev/hwdb.d/70-thinkpad-t480-caps-f9.hwdb /etc/udev/hwdb.d/
#   sudo systemd-hwdb update
#   sudo udevadm trigger --subsystem-match=input --action=change

evdev:atkbd:dmi:bvn*:bvr*:bd*:svnLENOVO*:pn*:pvrThinkPad*T480*:*
 KEYBOARD_KEY_3a=f9
