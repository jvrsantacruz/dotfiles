# GitHub with the lab's own key. It is not a name ssh tries by default, and a
# session over ssh carries no agent, so without this `git pull` is refused.
Host github.com
    IdentityFile ~/.ssh/id_jvrsantacruz
    IdentitiesOnly yes

# Everywhere else too, for the same reason: the ssh role's key-only login
# probe connects from this machine to itself, and the key is on its
# authorized_keys as ed25519-jvrlab-self.
Host *
    IdentityFile ~/.ssh/id_jvrsantacruz
